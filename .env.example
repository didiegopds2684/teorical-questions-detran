# Copy to .env and adjust. Local Postgres (see repo docker-compose.yml):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/autocurso
#
# Railway: serviço "teoretical-questions-detran" → Variables → Reference → Postgres → DATABASE_URL

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/autocurso
PORT=3000
NODE_ENV=development

# Set to "false" to hide Swagger UI at /docs (OpenAPI JSON at /openapi.json remains)
ENABLE_SWAGGER=true

# Public URL used in OpenAPI/Swagger servers (recommended in production)
# API_BASE_URL=https://teoretical-questions-detran-production.up.railway.app

# Optional: path to questions.json (default: ../extractor/data/questions.json relative to api/)
# QUESTIONS_JSON_PATH=/absolute/path/to/questions.json

# Backoffice / server-to-server (min 16 chars)
ADMIN_API_KEY=change-me-admin-key-32chars-min!!

# Vitest integration tests (see README)
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/autocurso_test
